src/coot-density-score-by-residue-bin
python/coot_load_modules.py
pyrogen/pyrogen
pyrogen/coot_git.py
ligand/coot-make-ligands-db
ligand/findligand-bin
ligand/findwaters-bin
ligand/identify-protein-bin
ideal/mini-rsr-bin
ideal/coot-ligand-validation-bin
