0-coot-history.py
0-coot-history.scm
coot-backup/
cootrc

# OS / editor cruft
.DS_Store
.claude/
*~

# v0.1.0.3 per-build counter + generated header
.build-counter
src/bandicoot-build-id.h

# Standalone diagnostics under tools/ -- built by their own build.sh, not by
# make, so nothing else ignores their binaries.
tools/gemmi-diff/gemmi-mmdb-diff

# Debug-symbol bundles left by any -g build on macOS
*.dSYM/

# Python bytecode (e.g. python/__pycache__/ from importing the ported modules)
__pycache__/
*.pyc
*.pyo

# Dependency trees built by scripts/build_canvas_deps.sh (not source)
/deps/

# Maintainer dev-build marker: enables the -uN version suffix (never shipped)
.bandicoot-dev

# Autoconf dependency-style probe scratch. configure creates and removes these
# itself, so they only survive an interrupted configure (Ctrl-C mid-build).
confmf
/sub/

# Per-machine build overrides sourced by scripts/build.sh (never shipped)
.bandicoot-local
