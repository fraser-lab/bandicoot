macros/libtool.m4
macros/ltoptions.m4
macros/ltsugar.m4
macros/ltversion.m4
macros/lt~obsolete.m4

# Object files, libtool intermediates, libraries
*.o
*.lo
*.la
*.Po
*.Plo
.deps/
.libs/
.dirstamp

# Generated from .in / SWIG / build
src/coot
src/coot_wrap_guile.cc
src/coot_wrap_guile_pre.cc
src/git-revision-count.cc
src/coot-version.h
src/coot-bin
